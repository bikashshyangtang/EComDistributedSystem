@page "/customers"
@using FrontEnd.Models
@using FrontEnd.Services
@inject ApiService Api

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h3 class="mb-1">Customers</h3>
        <p class="text-muted mb-0" style="font-size:0.875rem">Manage your customers</p>
    </div>
    <a href="/customers/add" class="btn btn-success">+ Add Customer</a>
</div>

@if (errorMessage != null)
{
    <div class="alert alert-danger alert-dismissible">
        @errorMessage
        <button type="button" class="btn-close" @onclick="() => errorMessage = null"></button>
    </div>
}

<div class="card" style="border:1px solid #e9e8f0">
    <div class="card-header bg-white py-2 px-3" style="border-bottom:1px solid #e9e8f0">
        <span class="text-muted" style="font-size:0.8rem">@(customers?.Count ?? 0) items</span>
    </div>

    @if (customers == null)
    {
        <div class="card-body text-center text-muted py-5">
            <div class="spinner-border spinner-border-sm me-2" style="color:#534AB7"></div> Loading...
        </div>
    }
    else if (customers.Count == 0)
    {
        <div class="card-body text-center text-muted py-5">
            No customers yet. <a href="/customers/add">Add the first one.</a>
        </div>
    }
    else
    {
        <table class="table table-hover mb-0 align-middle">
            <thead style="background:#faf9ff">
                <tr>
                    <th style="width:60px;font-size:0.7rem;text-transform:uppercase;letter-spacing:.06em;color:#888;font-weight:500;padding:10px 16px;border-bottom:1px solid #e9e8f0">S.N</th>
                    <th style="font-size:0.7rem;text-transform:uppercase;letter-spacing:.06em;color:#888;font-weight:500;padding:10px 16px;border-bottom:1px solid #e9e8f0">Name</th>
                    <th style="font-size:0.7rem;text-transform:uppercase;letter-spacing:.06em;color:#888;font-weight:500;padding:10px 16px;border-bottom:1px solid #e9e8f0">Email</th>
                </tr>
            </thead>
            <tbody>
                @for (int i = 0; i < customers.Count; i++)
                {
                    var customer = customers[i];
                    var sn = i + 1;
                    <tr>
                        <td style="padding:12px 16px;color:#aaa;font-size:0.8rem">@sn</td>
                        <td style="padding:12px 16px;font-weight:500;font-size:0.875rem">@customer.Name</td>
                        <td style="padding:12px 16px;font-size:0.875rem">@customer.Email</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private List<CustomerDto>? customers;
    private string? errorMessage;

    protected override async Task OnInitializedAsync()
    {
        try { customers = await Api.GetCustomersAsync(); }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
